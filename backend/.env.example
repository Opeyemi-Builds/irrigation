# Copy this file to .env and fill in your values
# Never commit .env to git

# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: OpenWeatherMap API key for real weather data
# If left empty, the backend uses mock weather data
OPENWEATHER_API_KEY=your_openweathermap_key_here

# Your farm location (for weather API)
FARM_LAT=7.3775
FARM_LON=3.9470

# CORS — set to your frontend dev URL
FRONTEND_URL=http://localhost:5173

# ── Supabase (database) ───────────────────────────────────────────────────────
# Create a free project at https://supabase.com, then in the dashboard go to:
#   Project Settings → API
#   • "Project URL"            → SUPABASE_URL
#   • "service_role" secret    → SUPABASE_SERVICE_KEY
# The service_role key is SECRET. It lives ONLY here in the backend — never put
# it in the frontend or commit it. Leave both blank to run without a database.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
